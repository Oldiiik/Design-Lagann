{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lagann.local/schemas/rubric.schema.json",
  "title": "Design Lagann rubric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "critic",
    "purpose",
    "mode",
    "weight",
    "hardGate",
    "requiredEvidence",
    "scale",
    "checks",
    "acceptance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "critic": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "vision",
        "static",
        "hybrid",
        "evidence"
      ]
    },
    "weight": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "hardGate": {
      "type": "boolean"
    },
    "requiredEvidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "anchors"
      ],
      "properties": {
        "min": {
          "const": 0
        },
        "max": {
          "const": 4
        },
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "0",
            "1",
            "2",
            "3",
            "4"
          ],
          "properties": {
            "0": {
              "type": "string",
              "minLength": 1
            },
            "1": {
              "type": "string",
              "minLength": 1
            },
            "2": {
              "type": "string",
              "minLength": 1
            },
            "3": {
              "type": "string",
              "minLength": 1
            },
            "4": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "passCondition",
          "failureSignals",
          "evidence",
          "weight",
          "gate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "passCondition": {
            "type": "string",
            "minLength": 1
          },
          "failureSignals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "gate": {
            "type": "boolean"
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumNormalizedScore",
        "blockOnGateFailure",
        "blockingRules"
      ],
      "properties": {
        "minimumNormalizedScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "blockOnGateFailure": {
          "type": "boolean"
        },
        "blockingRules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
